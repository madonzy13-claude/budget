# Budget — Non-secret configuration template
# Copy to .env — this file is safe to commit.
#
# SECRETS (passwords, KEK, auth secret, DSNs) are stored in Infisical.
# Run `infisical secrets --env=dev` to view them.
# Run `make dev` — Infisical injects secrets automatically before compose starts.
#
# To add a new secret:  make secrets-set KEY=MY_SECRET VALUE=the-value
# To rotate a secret:   infisical secrets set MY_SECRET=new-value --env=dev

# ── Application URLs ──────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Email (dev: mailpit SMTP capture) ────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@budget.local
# SMTP_USER=
# SMTP_PASS=

# ── Region (PLAT-11) ─────────────────────────────────────────────────────────
REGION=eu-central-1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Demo account (Phase 12) ───────────────────────────────────────────────
# UNSET = the demo is completely off: the worker never registers the queue and
# nothing ever reads the source budgets. Real values live in Infisical.
#
# The two lists are paired POSITIONALLY and must be the same length — a
# mismatch is refused rather than guessed, because a wrong pairing would copy
# the wrong household budget into a public login.
DEMO_SOURCE_TENANT_IDS=   # real budgets to copy FROM, comma-separated
DEMO_TENANT_IDS=          # demo budgets to copy INTO, same order
DEMO_USER_ID=             # the shared demo account's user id
DEMO_SECOND_USER_ID=      # optional 2nd member, so the family budget reads as shared
DEMO_CURRENCIES=USD,PLN   # each demo budget's default_currency
DEMO_BUDGET_NAMES=Personal,Family
DEMO_LABELS=personal,family
DEMO_HOME_CURRENCY=PLN    # source home currency; relabeled to the demo currency
# DEMO_MONEY_SCALE=       # TESTS ONLY. Production leaves this unset and draws a
                          # fresh log-uniform factor in [0.1,10] every night.
DEMO_EMAIL=                # shared demo login, used server-side by /[locale]/demo
DEMO_PASSWORD=             # never exposed to the client bundle
DEMO_SHARED_LABELS=family  # which pairs get the 2nd member; others stay personal
