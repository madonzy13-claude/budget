# Budget — Non-secret configuration template
# Copy to .env — this file is safe to commit.
#
# SECRETS (passwords, KEK, auth secret, DSNs) are stored in Infisical.
# Run `infisical secrets --env=dev` to view them.
# Run `make dev` — Infisical injects secrets automatically before compose starts.
#
# To add a new secret:  make secrets-set KEY=MY_SECRET VALUE=the-value
# To rotate a secret:   infisical secrets set MY_SECRET=new-value --env=dev

# ── Application URLs ──────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Email (dev: mailpit SMTP capture) ────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@budget.local
# SMTP_USER=
# SMTP_PASS=

# ── Region (PLAT-11) ─────────────────────────────────────────────────────────
REGION=eu-central-1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Demo account (Phase 12) ───────────────────────────────────────────────
# UNSET = the demo is completely off: the worker never registers the job,
# /demo is a 404, and demoGuard is a no-op. Real values live in Infisical.
#
# ONE ACCOUNT PER LANGUAGE. The demo's DATA (category names, transaction notes,
# wallets, incomes) is written into the database in one language, so a single
# shared account cannot serve three. /pl/demo signs the visitor into the Polish
# account, which owns Polish budgets.
DEMO_LOCALES=en,pl,uk

# The real budgets to copy FROM. Paired POSITIONALLY with each locale's
# destination list, and a length mismatch is refused rather than guessed —
# a wrong pairing would copy the wrong household budget into a public login.
DEMO_SOURCE_TENANT_IDS=
# Each demo budget's default_currency, per language: the PERSONAL budget uses
# that language's own currency, the shared FAMILY budget is always euro. Keeping
# them different is deliberate — it is what makes the all-budgets total a real
# FX conversion rather than plain addition. The account's display currency
# follows its personal budget and is set by the refresh job.
DEMO_CURRENCIES=USD,EUR     # fallback for a single-locale deployment
DEMO_CURRENCIES_EN=USD,EUR
DEMO_CURRENCIES_PL=PLN,EUR
DEMO_CURRENCIES_UK=UAH,EUR
DEMO_LABELS=personal,family
DEMO_SHARED_LABELS=family   # which pairs get a 2nd member; others stay personal
DEMO_HOME_CURRENCY=PLN      # source home currency; relabeled to the demo's

# Per language: the destination budgets, the account, its optional 2nd member,
# and the credentials the /demo route signs in with SERVER-SIDE (they never
# reach the client bundle). The un-suffixed DEMO_* names still work as English.
DEMO_TENANT_IDS_EN=
DEMO_USER_ID_EN=
DEMO_SECOND_USER_ID_EN=
DEMO_EMAIL_EN=
DEMO_PASSWORD_EN=
DEMO_TENANT_IDS_PL=
DEMO_USER_ID_PL=
DEMO_SECOND_USER_ID_PL=
DEMO_EMAIL_PL=
DEMO_PASSWORD_PL=
DEMO_TENANT_IDS_UK=
DEMO_USER_ID_UK=
DEMO_SECOND_USER_ID_UK=
DEMO_EMAIL_UK=
DEMO_PASSWORD_UK=

# The money factor, per budget, as "personal,family". A CONSTANT — it used to
# be re-rolled nightly, which swung capitalization 60-90% between consecutive
# days and made the demo look like a household in freefall to anyone who
# visited twice. Per budget because one constant cannot make a dollar budget
# and a hryvnia budget both look plausible. A missing or nonsensical value
# falls back to 1 (source magnitudes unchanged), never to a guess.
#
# Trade-off, chosen deliberately: a single fixed factor is the easiest of the
# schemes to divide out if anyone ever works out the constant.
DEMO_MONEY_SCALES_EN=0.325,2.208
DEMO_MONEY_SCALES_PL=0.844,2.208
DEMO_MONEY_SCALES_UK=1.312,2.208
